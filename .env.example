# Copy to .env and adjust. All values have sensible defaults (see app/config.py).

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
# Optional. If set, clients must send: Authorization: Bearer <API_KEY>
# API_KEY=change-me

# --- Storage ---
MODELS_DIR=/opt/voice-ai/models

# --- Speech-to-text (faster-whisper) ---
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=ru
STT_PRELOAD=true

# --- Text-to-speech ---
# Engine: xtts (default, voice cloning, CPML weights) | piper (MIT, no cloning)
TTS_ENGINE=xtts
TTS_LANGUAGE=ru
TTS_DEVICE=cuda
TTS_PRELOAD=true

# XTTS-v2: optional default reference voice (6+ sec wav) for /v1/audio/speech
# XTTS_DEFAULT_SPEAKER_WAV=/opt/voice-ai/voices/my_voice.wav

# Piper: point these at a downloaded Russian voice when TTS_ENGINE=piper
# PIPER_MODEL_PATH=/opt/voice-ai/models/piper/ru_RU-irina-medium.onnx
# PIPER_CONFIG_PATH=/opt/voice-ai/models/piper/ru_RU-irina-medium.onnx.json
